async page=>{
 const seed=__PRIVATE_SEED__,base='C:/Users/lenovo/Desktop/SoftwareDevelopment/group_project/output/04-document-http-pages-2026-11-15/output/document-browser/',checks=[],screens=[]
 const mark=(n,v)=>{if(!v)throw new Error(n);checks.push(n)}
 async function shot(name){for(const width of [1440,360]){await page.setViewportSize({width,height:900});mark(name+'-'+width+'无横向溢出',await page.evaluate(()=>document.documentElement.scrollWidth<=document.documentElement.clientWidth));await page.screenshot({path:base+'screenshots/'+name+'-'+width+'.png',fullPage:true});screens.push(name+'-'+width+'.png')}}
 async function logout(){await page.getByRole('link',{name:'账号与班级',exact:true}).click();await page.getByRole('button',{name:'退出登录',exact:true}).click();await page.getByRole('heading',{name:'登录你的账号',exact:true}).waitFor()}
 async function login(name){const user=seed.users.find(u=>u.username===name);await page.getByLabel('用户名').fill(user.username);await page.locator('#password').fill(user.password);await page.getByRole('button',{name:'登录',exact:true}).click();await page.getByRole('heading',{name:'工作台',exact:true}).waitFor();await page.getByRole('link',{name:'资料',exact:true}).click();await page.getByRole('link',{name:'PDF与Word资料',exact:true}).click();await page.getByRole('heading',{name:'本班资料',exact:true}).waitFor()}
 await logout();await login('document-student-a');await page.getByRole('link',{name:'公开资料 clear-01.pdf',exact:true}).waitFor();mark('学生无上传入口',await page.getByRole('link',{name:'上传资料',exact:true}).count()===0);mark('学生不见扫描或失败资料',await page.getByRole('link',{name:'真实扫描件',exact:true}).count()===0&&await page.getByRole('link',{name:'真实加密PDF',exact:true}).count()===0);await shot('student-list')
 await page.getByRole('link',{name:'公开资料 clear-01.docx',exact:true}).click();await page.getByRole('heading',{name:'原文与出处',exact:true}).waitFor();mark('学生可见真实原文无重试',await page.locator('.document-source').count()>0&&await page.getByRole('button',{name:'重试解析',exact:true}).count()===0);await shot('student-word')
 await page.getByRole('link',{name:'← 返回PDF与Word资料',exact:true}).click();await page.goto(__ORIGIN__+'/app/materials/documents/upload');await page.getByRole('heading',{name:'无权上传资料',exact:true}).waitFor();mark('学生直接上传地址被阻止',true)
 await logout();await login('document-student-b');await page.getByText('当前班级还没有PDF与Word资料',{exact:true}).waitFor();await shot('other-class-empty');mark('跨班学生不见前班资料',await page.getByRole('link',{name:'公开资料 clear-01.pdf',exact:true}).count()===0)
 await page.goto(__ORIGIN__+'/app/materials/documents/1');await page.getByRole('alert').waitFor();mark('跨班原文显示拒绝错误',await page.locator('.document-body').count()===0);await shot('other-class-detail-denied')
 await logout();await login('document-teacher');await page.getByRole('link',{name:'上传资料',exact:true}).click();await page.locator('#document-title').fill('待切班应清除文件');await page.locator('#document-file').setInputFiles(base+'long.docx')
 await page.getByRole('link',{name:'账号与班级',exact:true}).click();await page.getByRole('link',{name:'资料',exact:true}).click();await page.getByRole('link',{name:'PDF与Word资料',exact:true}).click();await page.getByRole('link',{name:'上传资料',exact:true}).click();mark('离页后标题文件已清空',await page.locator('#document-title').inputValue()===''&&await page.locator('#document-file').evaluate(el=>el.files.length===0))
 return {checks,screens,mode:'actual student/class authorization and page unmount; no fake responses',url:page.url()}
}
