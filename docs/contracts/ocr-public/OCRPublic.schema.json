{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campusclaw.invalid/contracts/ocr/public-v1.schema.json",
  "$defs": {
    "Status": {
      "type": "object",
      "properties": {
        "document_id": {
          "$ref": "https://campusclaw.invalid/contracts/v1/ID.schema.json"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "format": {
          "enum": [
            "pdf",
            "docx",
            "png",
            "jpeg"
          ]
        },
        "original_version": {
          "const": 1
        },
        "original_status": {
          "enum": [
            "queued",
            "processing",
            "ready",
            "needs_ocr",
            "failed"
          ]
        },
        "page_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "status": {
          "enum": [
            "not_required",
            "idle",
            "queued",
            "processing",
            "failed",
            "needs_review",
            "ready"
          ]
        },
        "latest_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2147483647
        },
        "published_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2,
          "maximum": 2147483647
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "failure_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "corrupt",
            "encrypted",
            "unsupported_content",
            "resource_limit",
            "ocr_timeout",
            "worker_interrupted",
            "language_missing",
            "internal_failure"
          ]
        },
        "can_start": {
          "type": "boolean"
        },
        "can_retry": {
          "type": "boolean"
        }
      },
      "required": [
        "document_id",
        "title",
        "format",
        "original_version",
        "original_status",
        "page_count",
        "status",
        "latest_revision",
        "published_revision",
        "attempts",
        "failure_reason",
        "can_start",
        "can_retry"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ready"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "published_revision": {
                "type": "integer",
                "minimum": 2
              },
              "latest_revision": {
                "type": "integer",
                "minimum": 2
              },
              "failure_reason": {
                "type": "null"
              },
              "can_start": {
                "const": false
              },
              "can_retry": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "failure_reason": {
                "type": "string"
              },
              "attempts": {
                "type": "integer",
                "minimum": 1
              },
              "published_revision": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "idle"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "attempts": {
                "const": 0
              },
              "latest_revision": {
                "type": "null"
              },
              "published_revision": {
                "type": "null"
              },
              "failure_reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Revision": {
      "type": "object",
      "properties": {
        "document_id": {
          "$ref": "https://campusclaw.invalid/contracts/v1/ID.schema.json"
        },
        "original_version": {
          "const": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "kind": {
          "enum": [
            "ocr",
            "review"
          ]
        },
        "body": {
          "$ref": "https://campusclaw.invalid/contracts/draft/ocr/OCRReview.schema.json#/properties/pages/items/properties/text"
        },
        "pages": {
          "$ref": "https://campusclaw.invalid/contracts/draft/ocr/OCRReview.schema.json#/properties/pages"
        }
      },
      "required": [
        "document_id",
        "original_version",
        "revision",
        "kind",
        "body",
        "pages"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ocr"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "revision": {
                "const": 1
              }
            }
          },
          "else": {
            "properties": {
              "revision": {
                "type": "integer",
                "minimum": 2
              }
            }
          }
        }
      ]
    },
    "Citation": {
      "type": "object",
      "properties": {
        "document_id": {
          "$ref": "https://campusclaw.invalid/contracts/v1/ID.schema.json"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2147483647
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "char_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097151
        },
        "char_end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "url": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^/api/v1/documents/[1-9][0-9]{0,18}/ocr-revisions/[1-9][0-9]{0,9}$"
        }
      },
      "required": [
        "document_id",
        "title",
        "revision",
        "page",
        "char_start",
        "char_end",
        "quote",
        "url"
      ],
      "additionalProperties": false
    },
    "Accepted": {
      "type": "object",
      "properties": {
        "document_id": {
          "$ref": "https://campusclaw.invalid/contracts/v1/ID.schema.json"
        },
        "status": {
          "const": "accepted"
        }
      },
      "required": [
        "document_id",
        "status"
      ],
      "additionalProperties": false
    },
    "Search": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/Citation"
          }
        },
        "mode": {
          "const": "keyword"
        }
      },
      "required": [
        "items",
        "mode"
      ],
      "additionalProperties": false
    }
  }
}
