{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campusclaw.invalid/contracts/draft/ocr/OCRReviewReceipt.schema.json",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2147483647
    },
    "status": {
      "const": "ready"
    }
  },
  "required": [
    "document_id",
    "revision",
    "status"
  ],
  "additionalProperties": false
}
