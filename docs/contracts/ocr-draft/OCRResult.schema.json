{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campusclaw.invalid/contracts/draft/ocr/OCRResult.schema.json",
  "title": "DraftOCRResult",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "const": "needs_review"
        },
        "engine": {
          "const": "tesseract-5.5.4-fast-8741641"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2097152,
          "pattern": "^[^\\r\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\p{Cs}]+$"
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000000
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000000
              },
              "rotation_applied": {
                "enum": [
                  0,
                  90,
                  180,
                  270
                ]
              },
              "source": {
                "enum": [
                  "text_layer",
                  "ocr"
                ]
              },
              "char_start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2097151
              },
              "char_end": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2097152
              },
              "words": {
                "type": "array",
                "maxItems": 20000,
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000,
                      "pattern": "^[^\\r\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\p{Cs}]+$"
                    },
                    "char_start": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2097151
                    },
                    "char_end": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 2097152
                    },
                    "bbox": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "engine_confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "text",
                    "char_start",
                    "char_end",
                    "bbox",
                    "engine_confidence"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "page",
              "width",
              "height",
              "rotation_applied",
              "source",
              "char_start",
              "char_end",
              "words"
            ],
            "additionalProperties": false
          }
        },
        "quality": {
          "enum": [
            "acceptable_candidate",
            "low_quality"
          ]
        }
      },
      "required": [
        "status",
        "engine",
        "body",
        "pages",
        "quality"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "const": "failed"
        },
        "reason": {
          "enum": [
            "corrupt",
            "encrypted",
            "unsupported_content",
            "resource_limit",
            "ocr_timeout",
            "worker_interrupted",
            "language_missing",
            "internal_failure"
          ]
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    }
  ]
}
