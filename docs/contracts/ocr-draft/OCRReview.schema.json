{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campusclaw.invalid/contracts/draft/ocr/OCRReview.schema.json",
  "title": "DraftOCRReview",
  "type": "object",
  "properties": {
    "base_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483646
    },
    "acknowledged": {
      "const": true
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2097152,
            "pattern": "^[^\\r\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f\\p{Cs}]+$"
          }
        },
        "required": [
          "page",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "base_revision",
    "acknowledged",
    "pages"
  ],
  "additionalProperties": false
}
